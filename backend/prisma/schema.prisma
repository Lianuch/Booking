
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @unique @id @default(uuid())

  name String 
  email String @unique
  password String? 
  
  googleId String? @unique

  isActivated Boolean @default(false)
  activationLink String?

  authType AuthType @default(EMAIL)

  token Token? 
  Payments Payment[]

  role Role @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Token {
  id String @unique @id @default(uuid())
  userId String @unique
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  
  refreshToken String @unique
}

model Plan {
  id String @unique @id @default(uuid())

  duration String @unique
  price Int
  description String?
  Payments Payment[]

 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}


model Payment {
  id String @unique @id @default(uuid())

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  planId String
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  amount Decimal
  currency String

  status PaymentStatus @default(PENDING)
  method PaymentMethod @default(CRYPTO)
  methodId String? @unique



  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum PaymentMethod {
  CARD
  CRYPTO
  PAYPAL
  STRIPE
}

enum Role {
  USER 
  ADMIN
}
enum AuthType {
  EMAIL
  GOOGLE
  APPLE
}